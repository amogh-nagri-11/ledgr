# Copy to .env. Never commit real keys.

# --- AI layer -------------------------------------------------------------
# Set ONE of these. The app auto-detects whichever key is present, in this
# order: Gemini, Groq, OpenRouter, OpenAI.
#
# Without any of them the app still runs: extraction falls back to a heuristic
# (regex + token overlap) that produces the same finding shape.

# Google Gemini -- free tier, no card required. aistudio.google.com/apikey
# Default model is gemini-3.6-flash. Older ids (2.5) 404 for newer accounts.
GEMINI_API_KEY=

# Groq -- free tier, very fast. console.groq.com/keys
GROQ_API_KEY=

# OpenRouter -- aggregator, has free models. openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI -- paid.
OPENAI_API_KEY=

# Optional overrides.
#   LLM_PROVIDER  force one: gemini | groq | openrouter | ollama | openai
#   LLM_MODEL     override the provider's default model
#   LLM_BASE_URL  point at any other OpenAI-compatible endpoint
#
# For a fully local, account-free setup:
#   ollama serve && ollama pull qwen2.5:7b
#   LLM_PROVIDER=ollama
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# How many invoices to analyse at once. Free tiers meter per minute and each
# invoice is a full agentic loop, so keep this low (default 2).
LLM_CONCURRENCY=

# --- RazorpayX (sandbox / test keys ONLY) ---------------------------------
# Without these, payouts are simulated locally and marked source: "mock".
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Test contact/fund account to pay into during the demo.
RAZORPAYX_TEST_FUND_ACCOUNT_ID=

PORT=3000
